{
  "name": "dsh-fabric-delegation",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Tier-aware Fabric delegation Consumer over native DSH workflows and subagents",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-models": "workspace:^",
    "@monotykamary/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/dsh-workflow": "^0.1.0-rc.7",
    "@monotykamary/dsh-tool-workflow": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent-loop": "^0.1.0-rc.7",
    "@monotykamary/dsh-agent-loop-testkit": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-subagent": "^0.1.0-rc.7",
    "@monotykamary/dsh-subagent-spawn-in-process": "^0.1.0-rc.7",
    "@monotykamary/dsh-workflow-worker-thread": "^0.1.0-rc.7",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/dsh-workflow": "^0.1.0-rc.7",
    "@monotykamary/dsh-tool-workflow": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}
