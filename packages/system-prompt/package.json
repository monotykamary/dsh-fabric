{
  "name": "@dsh-fabric/system-prompt",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Fabric-owned system prompt override and native-prose minimization for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@monotykamary/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@monotykamary/dsh-tools": "link:../../../deepseek-harness/packages/core/tools"
  },
  "devDependencies": {
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@monotykamary/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@monotykamary/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "typescript": "^6.0.3"
  }
}
