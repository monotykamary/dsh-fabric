{
  "name": "dsh-fabric-schema",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Schema-enforced world state, evidence digests, and fail-closed certification for dsh-fabric",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./controller": {
      "types": "./lib/types/controller.d.ts",
      "default": "./lib/controller.js"
    },
    "./state-store": {
      "types": "./lib/types/state-store.d.ts",
      "default": "./lib/state-store.js"
    },
    "./workspace": {
      "types": "./lib/types/workspace.d.ts",
      "default": "./lib/workspace.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-mesh": "workspace:^",
    "dsh-fabric-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "dsh-fabric-host": "workspace:^",
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-session-projection": "^0.1.0-rc.7",
    "@monotykamary/dsh-storage": "^0.1.0-rc.7",
    "@monotykamary/dsh-storage-domain": "^0.1.0-rc.7",
    "@monotykamary/dsh-storage-json": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}