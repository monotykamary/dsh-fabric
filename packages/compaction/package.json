{
  "name": "dsh-fabric-compaction",
  "version": "0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Deterministic Fabric compaction provider and preset roster for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compiler": {
      "types": "./lib/types/compiler.d.ts",
      "default": "./lib/compiler.js"
    },
    "./presets": {
      "types": "./lib/types/presets.d.ts",
      "default": "./lib/presets.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-agent-presets": "^0.1.0-rc.7",
    "@monotykamary/dsh-compaction": "^0.1.0-rc.7",
    "@monotykamary/dsh-compaction-basic": "^0.1.0-rc.7",
    "@monotykamary/dsh-command-compact": "^0.1.0-rc.7",
    "@monotykamary/dsh-commands": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-token-meter": "^0.1.0-rc.7",
    "@monotykamary/dsh-tool-session-query": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-agent-presets": "^0.1.0-rc.7",
    "@monotykamary/dsh-compaction": "^0.1.0-rc.7",
    "@monotykamary/dsh-compaction-basic": "^0.1.0-rc.7",
    "@monotykamary/dsh-command-compact": "^0.1.0-rc.7",
    "@monotykamary/dsh-commands": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-token-meter": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}