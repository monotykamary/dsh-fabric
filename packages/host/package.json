{
  "name": "dsh-fabric-host",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH session-event and activity projection adapter for dsh-fabric",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-protocol": "workspace:^",
    "dsh-fabric-system-prompt": "workspace:^",
    "@monotykamary/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-compaction": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-session-projection": "^0.1.0-rc.7",
    "@monotykamary/dsh-tool-workflow": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/dsh-workflow": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-compaction": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-llm": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-session-projection": "^0.1.0-rc.7",
    "@monotykamary/dsh-tool-workflow": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7",
    "@monotykamary/dsh-workflow": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}