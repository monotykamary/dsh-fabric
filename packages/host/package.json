    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-compaction": "link:../../../deepseek-harness/packages/compaction/compaction",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@monotykamary/dsh-session-projection": "link:../../../deepseek-harness/packages/session/session-projection",
    "@monotykamary/dsh-tool-workflow": "link:../../../deepseek-harness/packages/workflow/tool-workflow",
    "@monotykamary/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@monotykamary/dsh-workflow": "link:../../../deepseek-harness/packages/workflow/workflow"
  },
  "devDependencies": {
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-compaction": "link:../../../deepseek-harness/packages/compaction/compaction",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@monotykamary/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@monotykamary/dsh-session-projection": "link:../../../deepseek-harness/packages/session/session-projection",
    "@monotykamary/dsh-tool-workflow": "link:../../../deepseek-harness/packages/workflow/tool-workflow",
    "@monotykamary/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@monotykamary/dsh-workflow": "link:../../../deepseek-harness/packages/workflow/workflow"
  }
