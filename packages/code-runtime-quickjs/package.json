{
  "name": "dsh-fabric-code-runtime-quickjs",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Checked QuickJS WASM provider for DeepSeek Harness CodeRuntime",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@monotykamary/schemastery": "^3.18.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-code-runtime": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-code-runtime": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}