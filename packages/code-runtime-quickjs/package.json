{
  "name": "@dsh-fabric/code-runtime-quickjs",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "description": "Checked QuickJS WASM provider for DeepSeek Harness CodeRuntime",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@monotykamary/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@dsh-fabric/system-prompt": "workspace:^",
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-code-runtime": "link:../../../deepseek-harness/packages/code-runtime/code-runtime",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-session": "link:../../../deepseek-harness/packages/core/session"
  },
  "devDependencies": {
    "@dsh-fabric/system-prompt": "workspace:^",
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-code-runtime": "link:../../../deepseek-harness/packages/code-runtime/code-runtime",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@monotykamary/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@monotykamary/dsh-tools": "link:../../../deepseek-harness/packages/core/tools"
  }
}
