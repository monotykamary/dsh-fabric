{
  "name": "dsh-fabric-models",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Live session model inspection and alias-aware switching for dsh-fabric",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@monotykamary/schemastery": "^0.1.0"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-host-apiproxy": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.0-rc.7",
    "@monotykamary/dsh-host-apiproxy": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-session": "^0.1.0-rc.7",
    "@monotykamary/dsh-system-prompt": "^0.1.0-rc.7",
    "@monotykamary/dsh-tools": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}
