{
  "name": "dsh-fabric-client-ui",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Fabric Activity and Topology views for the DeepSeek Harness browser client",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@monotykamary/dsh-client-runtime",
        "@monotykamary/dsh-client-locale",
        "@monotykamary/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "watch": "tsc -p tsconfig.json && tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-protocol": "workspace:^",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-client-connection": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-runtime": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-locale": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-conversation": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-subagent": "^0.1.0-rc.7",
    "@monotykamary/dsh-token-meter": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "dsh-fabric-host": "workspace:^",
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-client-connection": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-runtime": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-locale": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-conversation": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@monotykamary/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@monotykamary/dsh-host-apiproxy": "^0.1.0-rc.7",
    "@monotykamary/dsh-invariants": "^0.1.0-rc.7",
    "@monotykamary/dsh-subagent": "^0.1.0-rc.7",
    "@monotykamary/dsh-token-meter": "^0.1.0-rc.7",
    "@types/react": "~18.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}