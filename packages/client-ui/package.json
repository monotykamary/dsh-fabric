{
  "name": "@dsh-fabric/client-ui",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "description": "Fabric Activity and Topology views for the DeepSeek Harness browser client",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@monotykamary/dsh-client-runtime",
        "@monotykamary/dsh-client-locale",
        "@monotykamary/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "watch": "tsc -p tsconfig.json && tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-fabric/protocol": "workspace:^",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-client-connection": "link:../../../deepseek-harness/packages/client/connection",
    "@monotykamary/dsh-client-runtime": "link:../../../deepseek-harness/packages/client/runtime",
    "@monotykamary/dsh-client-locale": "link:../../../deepseek-harness/packages/client/locale",
    "@monotykamary/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@monotykamary/dsh-client-ui-primitives": "link:../../../deepseek-harness/packages/client/ui-primitives",
    "@monotykamary/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-subagent": "link:../../../deepseek-harness/packages/subagent/subagent",
    "@monotykamary/dsh-token-meter": "link:../../../deepseek-harness/packages/llm/token-meter"
  },
  "devDependencies": {
    "@dsh-fabric/host": "workspace:^",
    "@monotykamary/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@monotykamary/dsh-client-connection": "link:../../../deepseek-harness/packages/client/connection",
    "@monotykamary/dsh-client-runtime": "link:../../../deepseek-harness/packages/client/runtime",
    "@monotykamary/dsh-client-locale": "link:../../../deepseek-harness/packages/client/locale",
    "@monotykamary/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@monotykamary/dsh-client-ui-primitives": "link:../../../deepseek-harness/packages/client/ui-primitives",
    "@monotykamary/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@monotykamary/dsh-host-apiproxy": "link:../../../deepseek-harness/packages/host/apiproxy",
    "@monotykamary/dsh-invariants": "link:../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@monotykamary/dsh-subagent": "link:../../../deepseek-harness/packages/subagent/subagent",
    "@monotykamary/dsh-token-meter": "link:../../../deepseek-harness/packages/llm/token-meter",
    "@types/react": "~18.3.0"
  }
}
