{
  "name": "dsh-fabric-mesh",
  "version": "0.1.11",
  "publishConfig": {
    "access": "public"
  },
  "description": "Durable topics, CAS state, and actor mailboxes for dsh-fabric",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./provider": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dsh-fabric-protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.7",
    "@monotykamary/dsh-invariants": "^0.1.7",
    "@monotykamary/dsh-session": "^0.1.7",
    "@monotykamary/dsh-system-prompt": "^0.1.7",
    "@monotykamary/dsh-storage-domain": "^0.1.7",
    "@monotykamary/dsh-tools": "^0.1.7",
    "@monotykamary/dsh-workspace": "^0.1.7"
  },
  "devDependencies": {
    "dsh-fabric-code-runtime-quickjs": "workspace:^",
    "dsh-fabric-host": "workspace:^",
    "@monotykamary/cordis": "^4.0.1",
    "@monotykamary/dsh-agent": "^0.1.7",
    "@monotykamary/dsh-invariants": "^0.1.7",
    "@monotykamary/dsh-llm": "^0.1.7",
    "@monotykamary/dsh-session": "^0.1.7",
    "@monotykamary/dsh-session-projection": "^0.1.7",
    "@monotykamary/dsh-system-prompt": "^0.1.7",
    "@monotykamary/dsh-storage": "^0.1.7",
    "@monotykamary/dsh-storage-domain": "^0.1.7",
    "@monotykamary/dsh-storage-json": "^0.1.7",
    "@monotykamary/dsh-tools": "^0.1.7",
    "@monotykamary/dsh-workspace": "^0.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-fabric.git"
  }
}